# ==============================================================================
# DriveLearn (Nihongo LMS) - Biến Môi Trường Triển Khai Self-Host
# ==============================================================================
# Sao chép file này thành .env: cp .env.example .env

# ── 1. Cấu hình AI & Google Gemini (Tùy chọn nếu không nhập trên Web) ─────────
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGoogleStudioKeyHere
AI__Provider=gemini
AI__Model=gemini-1.5-flash
AI__BaseUrl=https://generativelanguage.googleapis.com/v1beta/openai/

# ── 2. Cấu hình Cơ Sở Dữ Liệu PostgreSQL (Docker) ─────────────────────────────
POSTGRES_DB=nihongo_lms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2026
POSTGRES_PORT=5433

# ── 3. Cấu hình Bảo Mật & JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=NihongoLms-SuperSecretKey-MustBeAtLeast32CharsLong-2026
SYSTEM_ENCRYPTION_KEY=NihongoLms-LocalDatabase-EncryptionSecret-2026

# ── 4. Cấu hình URL & Port ────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=5222
NEXT_PUBLIC_API_URL=http://localhost:5222/api
